# Environment variables — copy to `.env` and adjust values.
# Never commit `.env` with real secrets.

# Application
APP_NAME=Green Garden API
APP_ENV=development
DEBUG=false

# PostgreSQL (used by Docker Compose)
POSTGRES_DB=green_garden
POSTGRES_USER=green_garden
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# SQLAlchemy async URL (psycopg3)
# Host `db` is the Docker Compose service name.
DATABASE_URL=postgresql+psycopg://green_garden:change_me_strong_password@db:5432/green_garden
