# Environment variables — copy to `.env` and adjust values.
# Never commit `.env` with real secrets.

# Application
APP_NAME=Green Garden API
APP_ENV=development
DEBUG=false

# PostgreSQL (used by Docker Compose)
POSTGRES_DB=green_garden
POSTGRES_USER=green_garden
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# SQLAlchemy async URL (psycopg3)
# Host `db` is the Docker Compose service name.
DATABASE_URL=postgresql+psycopg://green_garden:change_me_strong_password@db:5432/green_garden

# Optional separate DB for pytest (recommended)
TEST_DATABASE_URL=postgresql+psycopg://green_garden:change_me_strong_password@db:5432/green_garden_test

# JWT (use a long random secret in production — never commit real secrets)
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth cookies (Secure=true + SameSite=none required for cross-site production)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_ACCESS_COOKIE_NAME=gg_access_token
AUTH_REFRESH_COOKIE_NAME=gg_refresh_token
# Shared cookie domain for www + api subdomains. Leave empty for local host-only cookies.
# Production example: AUTH_COOKIE_DOMAIN=.ngocnganbentre.vn
AUTH_COOKIE_DOMAIN=

# CORS — comma-separated Next.js origins (never use * with credentials)
CORS_ORIGINS=http://localhost:3000

# Weaviate (vector DB for AI/RAG knowledge indexing; PostgreSQL stays source of truth)
# Set WEAVIATE_ENABLED=true after `docker compose up` includes the weaviate service.
WEAVIATE_ENABLED=false
# Inside Docker Compose the API service is wired to host `weaviate` on 8080/50051.
# From the host machine (scripts outside Compose), use localhost + published ports.
WEAVIATE_HTTP_HOST=weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=weaviate
WEAVIATE_GRPC_PORT=50051
WEAVIATE_HTTP_SECURE=false
WEAVIATE_GRPC_SECURE=false
# Optional host publish ports (docker-compose only)
WEAVIATE_HOST_HTTP_PORT=8080
WEAVIATE_HOST_GRPC_PORT=50051
# Optional — only needed if Weaviate auth is enabled
WEAVIATE_API_KEY=

# Optional — enables Weaviate text2vec-openai embeddings when set
OPENAI_API_KEY=

# DeepSeek chat (OpenAI-compatible). Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Request timeout in seconds for streaming chat completions
DEEPSEEK_TIMEOUT_SECONDS=60
