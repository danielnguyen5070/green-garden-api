# Environment variables — copy to `.env` and adjust values.
# Never commit `.env` with real secrets.

# Application
APP_NAME=Green Garden API
APP_ENV=development
DEBUG=false
# Log level for app loggers (DEBUG=true forces DEBUG)
LOG_LEVEL=INFO

# Docker Compose: layer the monitoring stack (Prometheus, Grafana, Alertmanager, exporters).
# Local dev: COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml:docker-compose.monitoring.yml
# VPS:       COMPOSE_FILE=docker-compose.yml:docker-compose.monitoring.yml

# PostgreSQL (Docker Compose)
POSTGRES_DB=green_garden
POSTGRES_USER=green_garden
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# SQLAlchemy
DATABASE_URL=postgresql+psycopg://green_garden:change_me_strong_password@db:5432/green_garden
TEST_DATABASE_URL=postgresql+psycopg://green_garden:change_me_strong_password@db:5432/green_garden_test
# Connection pool per uvicorn worker (total max = workers * (size + overflow))
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Monitoring
# Bearer token Prometheus uses to scrape /metrics; leave empty to disable the endpoint.
# Must equal the contents of monitoring/secrets/metrics_token.
# Generate with: openssl rand -hex 32
METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
# Telegram chat/group id for alerts (bot token goes in monitoring/secrets/telegram_bot_token)
TELEGRAM_CHAT_ID=
# postgres-exporter DSN. Prefer a read-only monitoring role:
#   CREATE ROLE monitoring WITH LOGIN PASSWORD 'change_me_monitoring_password';
#   GRANT pg_monitor TO monitoring;
POSTGRES_EXPORTER_DSN=postgresql://monitoring:change_me_monitoring_password@db:5432/green_garden?sslmode=disable

# Rate limiting (SlowAPI). Docker Compose defaults RATE_LIMIT_STORAGE_URI to
# redis://redis:6379/0 and TRUSTED_PROXIES to include the Docker bridge range.
# memory:// counters are per worker; use Redis when running more than one worker.
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_STRATEGY=moving-window
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=5/minute;20/hour
RATE_LIMIT_LOGIN_EMAIL_FAILURES=10/hour
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_CHAT=10/minute;60/hour;200/day
RATE_LIMIT_CHAT_GLOBAL=1000/hour
RATE_LIMIT_PUBLIC_WRITE=10/minute;50/hour
RATE_LIMIT_QUOTE=30/minute
# Peers allowed to set X-Forwarded-For (comma-separated IPs/CIDRs)
# TRUSTED_PROXIES=127.0.0.1,::1

# JWT
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth cookies
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_ACCESS_COOKIE_NAME=gg_access_token
AUTH_REFRESH_COOKIE_NAME=gg_refresh_token
# Optional production shared domain, e.g. .ngocnganbentre.vn
# AUTH_COOKIE_DOMAIN=

# CORS
CORS_ORIGINS=http://localhost:3000

# Weaviate
# Host/scripts: http://localhost:8080
# Docker Compose overrides WEAVIATE_URL=http://weaviate:8080 for the API service.
WEAVIATE_ENABLED=false
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_PORT=50051
RAG_TOP_K=3
# Optional embeddings for Weaviate vectors
# OPENAI_API_KEY=
# Optional Weaviate auth (leave unset for anonymous local Compose)
# WEAVIATE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60

# Next.js storefront cache webhook, called after catalog/stock/review changes.
# Leave unset to disable. The secret must equal REVALIDATE_WEBHOOK_SECRET in green-garden.
# STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
# STOREFRONT_REVALIDATE_SECRET=

# SePay bank transfer (VietQR). Leave SEPAY_ACCOUNT_NUMBER or SEPAY_WEBHOOK_API_KEY
# unset to disable the Bank Transfer checkout option.
# SEPAY_WEBHOOK_API_KEY must equal the API Key configured on the SePay webhook
# (SePay sends `Authorization: Apikey <key>`).
# SEPAY_WEBHOOK_API_KEY=
# Bank code/short name/BIN accepted by qr.sepay.vn, e.g. MB, VCB, 970422.
SEPAY_BANK_CODE=MB
# SEPAY_BANK_NAME=Ngân hàng TMCP Quân đội (MB)
# Full SePay VA (e.g. VQR...) or bank account number the customer transfers to.
# SEPAY_ACCOUNT_NUMBER=
# SEPAY_ACCOUNT_HOLDER=NGUYEN HOANG VIET
