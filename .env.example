# Environment variables — copy to `.env` and adjust values.
# Never commit `.env` with real secrets.

# Application
APP_NAME=Green Garden API
APP_ENV=development
DEBUG=false

# PostgreSQL (used by Docker Compose)
POSTGRES_DB=green_garden
POSTGRES_USER=green_garden
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# SQLAlchemy async URL (psycopg3)
# Host `db` is the Docker Compose service name.
DATABASE_URL=postgresql+psycopg://green_garden:change_me_strong_password@db:5432/green_garden

# Optional separate DB for pytest (recommended)
TEST_DATABASE_URL=postgresql+psycopg://green_garden:change_me_strong_password@db:5432/green_garden_test

# JWT (use a long random secret in production — never commit real secrets)
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth cookies (Secure=true + SameSite=none required for cross-site production)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_ACCESS_COOKIE_NAME=gg_access_token
AUTH_REFRESH_COOKIE_NAME=gg_refresh_token

# CORS — comma-separated Next.js origins (never use * with credentials)
CORS_ORIGINS=http://localhost:3000
