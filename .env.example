# Environment variables — copy to `.env` and adjust values.
# Never commit `.env` with real secrets.

# Application
APP_NAME=Green Garden API
APP_ENV=development
DEBUG=false
# Log level for app loggers (DEBUG=true forces DEBUG)
LOG_LEVEL=INFO

# PostgreSQL (Docker Compose)
POSTGRES_DB=green_garden
POSTGRES_USER=green_garden
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# SQLAlchemy
DATABASE_URL=postgresql+psycopg://green_garden:change_me_strong_password@db:5432/green_garden
TEST_DATABASE_URL=postgresql+psycopg://green_garden:change_me_strong_password@db:5432/green_garden_test

# JWT
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth cookies
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_ACCESS_COOKIE_NAME=gg_access_token
AUTH_REFRESH_COOKIE_NAME=gg_refresh_token
# Optional production shared domain, e.g. .ngocnganbentre.vn
# AUTH_COOKIE_DOMAIN=

# CORS
CORS_ORIGINS=http://localhost:3000

# Weaviate
# Host/scripts: http://localhost:8080
# Docker Compose overrides WEAVIATE_URL=http://weaviate:8080 for the API service.
WEAVIATE_ENABLED=false
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_PORT=50051
RAG_TOP_K=3
# Optional embeddings for Weaviate vectors
# OPENAI_API_KEY=
# Optional Weaviate auth (leave unset for anonymous local Compose)
# WEAVIATE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60

# Next.js storefront cache webhook, called after catalog/stock/review changes.
# Leave unset to disable. The secret must equal REVALIDATE_WEBHOOK_SECRET in green-garden.
# STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
# STOREFRONT_REVALIDATE_SECRET=

# SePay bank transfer (VietQR). Leave SEPAY_ACCOUNT_NUMBER or SEPAY_WEBHOOK_API_KEY
# unset to disable the Bank Transfer checkout option.
# SEPAY_WEBHOOK_API_KEY must equal the API Key configured on the SePay webhook
# (SePay sends `Authorization: Apikey <key>`).
# SEPAY_WEBHOOK_API_KEY=
# Bank code/short name/BIN accepted by qr.sepay.vn, e.g. MB, VCB, 970422.
SEPAY_BANK_CODE=MB
# SEPAY_BANK_NAME=Ngân hàng TMCP Quân đội (MB)
# Full SePay VA (e.g. VQR...) or bank account number the customer transfers to.
# SEPAY_ACCOUNT_NUMBER=
# SEPAY_ACCOUNT_HOLDER=NGUYEN HOANG VIET
